# Render: Web Service > Environment > Add from .env.
# Required: use a remote MongoDB URI (for example, MongoDB Atlas).
DB_URL=
DB_NAME=CERTIFY
# Generate separate random secrets. Preserve existing values on redeploy.
SECRET_KEY=
ACCESS_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Actual frontend HTTPS origin, without /api/v1 or trailing slash.
# FRONTEND_URLS can contain multiple origins separated by commas.
FRONTEND_URLS=https://SEU-FRONTEND.onrender.com
FRONTEND_URL=https://SEU-FRONTEND.onrender.com
POETRY_VIRTUALENVS_CREATE=false
# Leave email disabled until a compatible SMTP provider/plan is configured.
EMAIL_WORKER_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
# Only enable after attaching a persistent disk mounted at /var/data:
# UPLOAD_DIR=/var/data/uploads
# PORT is provided by Render; do not hardcode it here.
