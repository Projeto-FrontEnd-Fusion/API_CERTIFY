          "raw": "{\n  \"name\": \"Curso Teste Postman\",\n  \"institution\": \"Empresa Teste Postman\",\n  \"description\": \"Evento criado para verificacao local\",\n  \"workload\": 8,\n  \"start_date\": \"2026-10-05T12:00:00Z\",\n  \"end_date\": \"2026-10-05T20:00:00Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
